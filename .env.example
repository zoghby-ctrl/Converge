OPENAI_API_KEY=
# Optional server-only perception provider (default: openai).
CONVERGE_PERCEPTION_PROVIDER=openai
GEMINI_API_KEY=
# Gemini uses gemini-3.8-flash for both primary and bounded recheck.
# Existing OPENAI_MAX_* development limits apply to either provider.
OPENAI_PRIMARY_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_FALLBACK_ENABLED=true
OPENAI_REASONING_EFFORT=none
# Persistent per-local-database development limits; cache/manual/replay work at the limit.
OPENAI_MAX_REQUESTS=80
OPENAI_MAX_SPEND_USD=1.00
